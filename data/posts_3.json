  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit4532z",
    "stype": 0,
    "PublishedOn": "2026-09-09T20:01:59.026Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3mv4ddit4532z",
      "BskyCID": "bafyreigkkmzp277gevraw6jzqxipaznwyvigmw6xqwozfpooqr5ws7lyui",
      "Description": "Además, Chris Bell llega al debut sin restricciones previstas. Tras recuperarse de la rotura de ACL sufrida en Louisville y volver durante la pretemporada, Hafley aseguró que no habrá un límite de snaps: jugará y evaluarán cómo responde durante el partido.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit4532z"

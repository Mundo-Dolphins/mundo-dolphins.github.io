  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit63n2z",
    "stype": 0,
    "PublishedOn": "2026-09-09T20:01:59.03Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3mv4ddit63n2z",
      "BskyCID": "bafyreih67fk2qhdtu66mrsld6kvddzy5nl6ge4uxljcbahvlseadizfmk4",
      "Description": "En resumen, Hafley no escondió que Miami llegará a Week 1 apoyándose mucho en su juventud: Bell y Douglas empiezan como titulares, Taaffe tendrá snaps pese al depth chart y Louis seguirá siendo una pieza híbrida. Las decisiones, insistió, se han tomado con ganar como prioridad.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit63n2z"
    },
    "InstagramPost": {
      "URL": "",
      "Description": "",
      "SvgPath": ""
    }
  },
  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit63m2z",
    "stype": 0,
    "PublishedOn": "2026-09-09T20:01:59.029Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3mv4ddit63m2z",
      "BskyCID": "bafyreigskoqckmee5hb744r6nubcfzvk6reorjo6n45ientabgghlehmdy",
      "Description": "Otro detalle importante: la defensa titular publicada es un paquete nickel pensado para responder a personal 11: 1 RB, 1 TE y 3 WR. Por eso aparece Chris Johnson en el slot. El depth chart no significa que esa vaya a ser la estructura defensiva ante cualquier formación.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit63m2z"

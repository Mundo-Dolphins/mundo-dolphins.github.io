    }
  },
  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit54e2z",
    "stype": 0,
    "PublishedOn": "2026-09-09T20:01:59.028Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3mv4ddit54e2z",
      "BskyCID": "bafyreicb4r5qkfmhseuhlw3mnw36n44pwupqnjzkvqfuvz47jlb7af4y5a",
      "Description": "También explicó por qué Kyle Louis aparece ahora como safety. Ha trabajado más ahí durante las últimas semanas y el depth chart obligaba a asignarle una posición, pero Miami seguirá utilizándolo también como linebacker. Su valor está precisamente en esa versatilidad.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit54e2z"

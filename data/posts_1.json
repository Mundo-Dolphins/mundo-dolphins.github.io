    }
  },
  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3muyjr56jqw2t",
    "stype": 0,
    "PublishedOn": "2026-09-08T07:46:19.624Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3muyjr56jqw2t",
      "BskyCID": "bafyreigvxupecogxpyjfglqyfrfxhyzjzvgescv2xys5pf6ibzecnlgcci",
      "Description": "Y el primer examen será enorme. Hafley dijo que Miami deberá saber dónde está Maxx Crosby en cada jugada porque puede destrozar un partido. En defensa ocurre lo mismo con Brock Bowers: su capacidad para alinearse como TE, en el slot o abierto obligará a Miami a ajustar constantemente.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3muyjr56jqw2t"

  },
  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit54d2z",
    "stype": 0,
    "PublishedOn": "2026-09-09T20:01:59.027Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3mv4ddit54d2z",
      "BskyCID": "bafyreiaq6eqfozwsavssaeehx2hitldnru3ejc5zibrpzqqlgbsts725iu",
      "Description": "En safety, el depth chart coloca a Dante Trader Jr. y Zayne Anderson como titulares, pero Hafley matizó esa lectura: considera que Miami tiene realmente tres safeties titulares. Michael Taaffe también jugará y formará parte de esa rotación.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3mv4ddit54d2z"

    }
  },
  {
    "id": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3muyjr56jqv2t",
    "stype": 0,
    "PublishedOn": "2026-09-08T07:46:19.623Z",
    "BlueSkyPost": {
      "BskyURI": "at://did:plc:b4gbufyiqbgjgooeuz6hblpc/app.bsky.feed.post/3muyjr56jqv2t",
      "BskyCID": "bafyreieevtewoyjnmvd3mw4xblbc3twcgpblvj3cpdthcfjpcxwbi6sj2y",
      "Description": "Patrick Paul, capitán por primera vez, no parece preocupado por el debut de Proctor: \"Está preparado. No tienes que decirle nada. Es un rookie diferente\". Paul contó además que ser capitán era uno de sus objetivos y habló de fijar estándares y exigir responsabilidad dentro del vestuario.",
      "BskyProfileURI": "https://bsky.app/profile/undolfan.mundodolphins.es",
      "BskyProfile": "Un Dolfan",
      "BskyPost": "https://bsky.app/profile/undolfan.mundodolphins.es/post/3muyjr56jqv2t"
